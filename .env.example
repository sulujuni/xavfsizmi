# ─────────────────────────────────────────────────────────────────────────────
# SafeLink Bot — Environment Configuration
# Copy this file to ".env" and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (REQUIRED — bot won't start without it)
BOT_TOKEN=

# Your Telegram numeric user ID (REQUIRED for admin panel /admin, /stats, /broadcast)
# Get it from @userinfobot
ADMIN_ID=

# Required-subscription channel (set to 0 to disable the subscription gate)
REQUIRED_CHANNEL_ID=0
CHANNEL_INVITE_LINK=

# ─── SECURITY API KEYS (at least one strongly recommended) ───────────────────
# Without these, URL/APK scanning returns empty/clean results — the bot runs
# but cannot actually detect threats. All have free tiers.

# VirusTotal — https://www.virustotal.com/gui/my-apikey  (free: 4 req/min, 500/day)
# Also used for APK scanning.
VIRUSTOTAL_API_KEY=

# Google Safe Browsing — https://developers.google.com/safe-browsing  (free: 10k/day)
GOOGLE_SAFE_BROWSING_KEY=

# AlienVault OTX — https://otx.alienvault.com/api  (free)
ALIENVAULT_API_KEY=

# URLScan.io — https://urlscan.io/user/profile/  (free: ~1000/day)
URLSCAN_API_KEY=

# ─── OPTIONAL: EXTRA API KEYS FOR ROTATION (Phase 2) ─────────────────────────
# Add numbered keys to increase throughput. The rate limiter rotates between
# all keys automatically. Add as many as you have (_2, _3, ... up to _10).
# VIRUSTOTAL_API_KEY_2=
# VIRUSTOTAL_API_KEY_3=
# GOOGLE_SAFE_BROWSING_KEY_2=

# ─── PAYMENTS (optional — only for UZS/So'm card payments) ───────────────────
# Telegram Stars payments need NO token. This is only for Payme/Click via a
# Telegram payment provider. Leave blank to disable card payments.
UZS_PROVIDER_TOKEN=

# ─── DATABASE (Phase 2) ──────────────────────────────────────────────────────
# Path to the SQLite database file.
# Default: /data/safelink.db if a /data volume exists, else ./safelink.db
# DB_PATH=safelink.db

# ─── CACHE (Phase 2 — optional) ──────────────────────────────────────────────
# Redis connection URL. If left blank, the bot uses an in-memory cache
# (works fine for a single instance; required if you run multiple instances).
# Example: redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_HOURS=24

# ─── LOGGING (Phase 2 — optional) ────────────────────────────────────────────
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=console      # "console" (colored) or "json" (for log aggregators)
# LOG_FILE=             # Optional path to also write JSON logs to a file
