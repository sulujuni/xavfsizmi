# ─────────────────────────────────────────────────────────────────────────────
# SafeLink Bot — environment configuration. Copy to .env and fill in values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED ────────────────────────────────────────────────────────────────
BOT_TOKEN=                       # from @BotFather
ADMIN_ID=                        # your numeric Telegram ID (from @userinfobot)

# Subscription gate (set channel id to 0 to disable)
REQUIRED_CHANNEL_ID=0
CHANNEL_INVITE_LINK=

# ─── SECURITY API KEYS (free tiers; without them scans return "clean") ───────
VIRUSTOTAL_API_KEY=              # virustotal.com (also used for APK scanning)
GOOGLE_SAFE_BROWSING_KEY=        # developers.google.com/safe-browsing
URLSCAN_API_KEY=                 # urlscan.io
ALIENVAULT_API_KEY=              # otx.alienvault.com

# ─── AI CHATBOT (optional) ───────────────────────────────────────────────────
GROQ_API_KEY=                    # console.groq.com (free llama3)

# ─── DATABASE (Phase 2 — SQLite) ─────────────────────────────────────────────
# Path to the SQLite file. Defaults to /data/safelink.db if a /data volume
# exists, otherwise ./safelink.db. The bot auto-migrates users.json on first run.
# DB_PATH=safelink.db

# ─── CACHE (Phase 2 — Redis, optional) ───────────────────────────────────────
# If set, used as a write-through cache in front of the database and for URL
# scan results. Leave blank to use the built-in in-memory cache (fine for a
# single instance). Required if you run multiple instances behind webhooks.
REDIS_URL=                       # e.g. redis://localhost:6379/0
CACHE_TTL_HOURS=24               # TTL for cached URL scan results
# CACHE_MAX_MEMORY=10000         # max entries for the in-memory fallback
# CACHE_PREFIX=safelink:         # key namespace in Redis

# ─── WEBHOOK (optional — for horizontal scaling) ─────────────────────────────
USE_WEBHOOK=false
WEBHOOK_URL=
PORT=8443
